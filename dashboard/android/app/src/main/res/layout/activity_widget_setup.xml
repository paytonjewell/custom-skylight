<?xml version="1.0" encoding="utf-8"?>
<!-- Setting up a Tasks widget (TasksWidgetConfigure.java) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hq_paper"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/fraunces_semibold"
            android:text="Tasks widget"
            android:textColor="@color/hq_ink"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:text="Today’s tasks for one person, on your home screen."
            android:textColor="@color/hq_mute"
            android:textSize="14sp" />

        <TextView
            style="@style/WidgetSetupLabel"
            android:text="Whose tasks" />

        <LinearLayout
            android:id="@+id/setup_people"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fraunces_italic"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Loading…"
            android:textColor="@color/hq_mute"
            android:textSize="16sp" />

        <TextView
            style="@style/WidgetSetupLabel"
            android:text="Background" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/widget_preview_wall">

            <FrameLayout
                android:layout_width="230dp"
                android:layout_height="96dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/setup_preview_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bg"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/widget_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/setup_preview_mark"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/widget_mark_neutral"
                        android:gravity="center"
                        android:text="🐱"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="Feed the cat"
                        android:textColor="@color/hq_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="See-through"
                android:textColor="@color/hq_mute"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/setup_opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="@color/hq_ink"
                android:thumbTint="@color/hq_ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Solid"
                android:textColor="@color/hq_mute"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/setup_opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:textColor="@color/hq_ink_2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/setup_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/widget_button"
            android:enabled="false"
            android:fontFamily="@font/inter_semibold"
            android:stateListAnimator="@null"
            android:text="Add widget"
            android:textAllCaps="false"
            android:textColor="@color/hq_on_ink"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
