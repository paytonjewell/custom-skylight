<?xml version="1.0" encoding="utf-8"?>
<!-- A solid pill button (the dashboard's primary button) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="@color/hq_line" /><corners android:radius="999dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/hq_ink" /><corners android:radius="999dp" /></shape>
    </item>
</selector>
