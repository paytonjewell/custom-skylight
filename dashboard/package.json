{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "cd .. && lefthook install",
    "frame": "node scripts/frame-chrome.mjs",
    "frame:shot": "node scripts/frame-shot.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p test/worker",
    "test": "vitest run",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm test && npm run knip",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "canvas-confetti": "^1.9.3",
    "emoji-mart": "^5.6.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
