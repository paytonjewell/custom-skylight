{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "frame": "node scripts/frame-chrome.mjs",
    "frame:shot": "node scripts/frame-shot.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --import ./test/resolve.mjs --test 'test/*.test.ts'",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "canvas-confetti": "^1.9.3",
    "emoji-mart": "^5.6.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
